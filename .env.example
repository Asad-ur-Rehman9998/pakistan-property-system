# PropertyCheck Pakistan — environment template
# Copy to `.env` for local use. Never commit `.env`.
#
# Never commit: API keys, passwords, secret keys, database credentials, private tokens.
# Guest `/check` still needs no account. Papers stay on the phone.

# --- App / session (required in production) ---
SESSION_SECRET=
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
STAFF_OWNER_EMAIL=

# --- Shared checks ---
# Local JSON by default. Set DJANGO_API_URL to persist via Django+Postgres.
CHECKS_DIR=./data/checks
# DJANGO_API_URL=http://127.0.0.1:8000

# --- Database (credentials belong only in `.env`, never in git) ---
# Shape only — replace USER / PASSWORD / host for your machine. Leave blank to use SQLite in Django.
DATABASE_URL=

# --- Object storage (optional; MinIO in Compose) ---
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Optional LLM restatement (PWA does not need this) ---
LLM_EXPLAIN_URL=
LLM_EXPLAIN_KEY=

# --- Plans — amounts from env or data/billing/plans.json, never hardcode in UI ---
PLAN_CURRENCY=PKR
PLAN_PRICE_PREMIUM=
PLAN_PRICE_DEALER=
PLAN_PRICE_PROFESSIONAL=

# --- Local data dirs (counts / hashes only — no papers, full CNICs, or share keys) ---
ANALYTICS_DIR=./data/analytics
USERS_DIR=./data/users
AUDIT_DIR=./data/audit
BILLING_DIR=./data/billing
COMPLAINTS_DIR=./data/complaints
REVIEWS_DIR=./data/reviews

# --- E2E (optional) ---
# E2E_URL=http://localhost:3000
